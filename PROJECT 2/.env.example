# ============================
# SERVER CONFIGURATION
# ============================
NODE_ENV=development
PORT=5000
API_VERSION=v1

# ============================
# MONGODB ATLAS
# ============================
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/smart-user-db?retryWrites=true&w=majority
MONGO_URI_TEST=mongodb://127.0.0.1:27017/smart-user-db-test

# ============================
# JWT AUTHENTICATION
# ============================
JWT_SECRET=replace_this_with_a_long_random_secret_string
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=replace_this_with_another_long_random_secret_string
JWT_REFRESH_EXPIRES_IN=7d

# ============================
# BCRYPT
# ============================
BCRYPT_SALT_ROUNDS=12

# ============================
# RATE LIMITING
# ============================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ============================
# CORS
# ============================
CORS_ORIGIN=http://localhost:3000

# ============================
# FILE UPLOAD
# ============================
MAX_FILE_UPLOAD_MB=5
UPLOAD_PATH=./uploads

# ============================
# CLOUDINARY (OPTIONAL)
# ============================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ============================
# EMAIL (NODEMAILER) - for password reset / verification
# ============================
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@smartuserapi.com

# ============================
# FRONTEND URL (used in email links)
# ============================
CLIENT_URL=http://localhost:3000

